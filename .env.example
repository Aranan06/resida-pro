# RESIDA PRO - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve kendi bilgilerinizle doldurun.
# ASLA .env dosyasını GitHub'a göndermeyin!

DB_HOST=localhost
DB_NAME=resida_pro
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Oturum ve güvenlik
SESSION_TIMEOUT=1800
APP_ENV=production
APP_DEBUG=false

# Ödeme - Senin RESIDA abonelik gelirin (yönetim sana öder)
# Aidat ödemeleri BURAYA değil, her sitenin kendi IBAN'ına (sites tablosu) gider!
RESIDA_BANK_NAME=Ziraat Bankası
RESIDA_BANK_IBAN=TR00 0000 0000 0000 0000 0000 00
RESIDA_BANK_HOLDER=RESIDA PRO - Abonelik Tahsilat
# Eski anahtarlar uyumluluk için de destekleniyor:
BANK_NAME=Ziraat Bankası
BANK_IBAN=TR00 0000 0000 0000 0000 0000 00
BANK_HOLDER=RESIDA PRO

# iyzico (şirket sonrası canlı anahtarlar - şimdilik sandbox)
IYZICO_API_KEY=sandbox-api-key
IYZICO_SECRET_KEY=sandbox-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Canlıya geçerken: https://api.iyzipay.com

# Cron güvenliği
CRON_TOKEN=resida-cron-2026

# e-Fatura entegratör (mock iken boş)
EFATURA_INTEGRATOR=mock
EFATURA_API_KEY=
EFATURA_API_SECRET=

# Web Push VAPID (npx web-push generate-vapid-keys ile üret)
